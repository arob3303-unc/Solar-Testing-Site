# Copy to .env for local dev, and set the same keys in the Vercel project
# (Settings → Environment Variables) for Preview and Production.
#
# .env is gitignored — never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key for the AI audit report (/api/analyze).
# Without it the dashboard still renders; the AI section shows an error.
ANTHROPIC_API_KEY=

# ── Optional: live data lookups (graceful fallbacks if unset) ───────────────
# NREL Utility Rate Database — live residential rate (/api/rates).
# Free key: https://developer.nrel.gov/signup/  ·  falls back to the U.S. average.
NREL_API_KEY=

# U.S. Energy Information Administration — state electricity profile (/api/outages).
# Free key: https://www.eia.gov/opendata/  ·  the row is hidden if unset.
EIA_API_KEY=

# ── Required for the internal /notes closer guide ───────────────────────────
# The gate FAILS CLOSED if either is missing: nobody can reach /notes.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
